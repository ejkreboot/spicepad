---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<BaseLayout title={`${title} - SpicePad Docs`}>
  <header class="docs-header">
    <div class="docs-header-inner">
      <a href="/docs/" class="docs-logo">
        <img src="/logo.webp" alt="SpicePad" class="header-logo">
        <span class="docs-title">Docs</span>
      </a>
      <nav class="docs-header-nav">
        <a href="/sim">App</a>
        <a href="https://github.com/nicerikor/spicepad" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>
  </header>

  <div class="docs-layout">
    <nav class="docs-sidebar" id="docs-nav">
      <ul>
        <li><a href="/docs/">Home</a></li>
        <li><a href="/docs/getting-started">Getting Started</a></li>
        <li><a href="/docs/loading-saving">Loading &amp; Saving</a></li>
        <li><a href="/docs/running-analyses">Running Analyses</a></li>
        <li><a href="/docs/analysis-overlays">Analysis Overlays</a></li>
      </ul>
    </nav>

    <main class="docs-content">
      <slot />
    </main>
  </div>

  <footer class="docs-footer">
    <p>&copy; {currentYear} SpicePad</p>
  </footer>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap');

  /* ── Docs page resets ───────────────────────────────── */
  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #fff;
    color: #0f0f0f;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Variables ──────────────────────────────────────── */
  :root {
    --docs-accent: #2563eb;
    --docs-fg: #0f0f0f;
    --docs-fg-muted: #4b5563;
    --docs-fg-faint: #9ca3af;
    --docs-border: #e5e7eb;
    --docs-surface: #f9fafb;
    --docs-header-h: 52px;
    --docs-sidebar-w: 224px;
    --docs-radius: 6px;
  }

  /* ── Header ─────────────────────────────────────────── */
  .docs-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--docs-header-h);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--docs-border);
  }

  .docs-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .docs-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--docs-fg);
  }

  .docs-logo .header-logo {
    height: 26px;
    width: auto;
  }

  .docs-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--docs-accent);
    border-left: 1px solid var(--docs-border);
    padding-left: 0.6rem;
    margin-left: 0.25rem;
  }

  .docs-header-nav {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .docs-header-nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--docs-fg-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .docs-header-nav a:hover {
    color: var(--docs-fg);
  }

  /* ── Page layout ────────────────────────────────────── */
  .docs-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    min-height: calc(100vh - var(--docs-header-h) - 52px);
  }

  /* ── Sidebar ────────────────────────────────────────── */
  .docs-sidebar {
    width: var(--docs-sidebar-w);
    flex-shrink: 0;
    padding: 2rem 0 2rem;
    border-right: 1px solid var(--docs-border);
    position: sticky;
    top: var(--docs-header-h);
    height: calc(100vh - var(--docs-header-h));
    overflow-y: auto;
    align-self: flex-start;
  }

  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docs-sidebar a {
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: var(--docs-radius);
    font-size: 0.875rem;
    color: var(--docs-fg-muted);
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }

  .docs-sidebar a:hover {
    background: var(--docs-surface);
    color: var(--docs-fg);
  }

  .docs-sidebar a[aria-current="page"],
  .docs-sidebar a.active {
    background: #eff6ff;
    color: var(--docs-accent);
    font-weight: 500;
  }

  /* ── Content ────────────────────────────────────────── */
  .docs-content {
    display: block;
    flex: 1;
    min-width: 0;
    padding: 3rem 4rem 4rem;
    max-width: 800px;
  }

  .docs-content > * + * {
    margin-top: 1rem;
  }

  .docs-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--docs-fg);
    margin-top: 0;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--docs-border);
  }

  .docs-content h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--docs-fg);
    margin-top: 2.5rem;
    margin-bottom: 0.625rem;
  }

  .docs-content h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--docs-fg);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .docs-content p {
    font-size: 0.9375rem;
    color: var(--docs-fg-muted);
    line-height: 1.8;
    margin-top: 0;
    margin-bottom: 0.6rem;
  }

  .docs-content ul,
  .docs-content ol {
    padding-left: 1.5rem;
    margin-top: 0;
    margin-bottom: 0;
  }

  .docs-content li {
    font-size: 0.9375rem;
    color: var(--docs-fg-muted);
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }

  .docs-content a {
    color: var(--docs-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }

  .docs-content a:hover {
    border-bottom-color: var(--docs-accent);
  }

  .docs-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--docs-radius);
    border: 1px solid var(--docs-border);
    margin: 1.5rem 0;
    display: block;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .docs-content code {
    font-family: 'DM Mono', 'Menlo', 'Consolas', monospace;
    font-size: 0.8125em;
    background: var(--docs-surface);
    border: 1px solid var(--docs-border);
    border-radius: 4px;
    padding: 0.15em 0.45em;
    color: var(--docs-fg);
  }

  .docs-content pre {
    background: #1a1b26;
    border-radius: var(--docs-radius);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    border: 1px solid #2a2b3a;
  }

  .docs-content pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    color: #a9b1d6;
  }

  .docs-content hr {
    border: none;
    border-top: 1px solid var(--docs-border);
    margin: 2rem 0;
  }

  .docs-content blockquote {
    border-left: 3px solid var(--docs-accent);
    background: #eff6ff;
    padding: 0.875rem 1.25rem;
    border-radius: 0 var(--docs-radius) var(--docs-radius) 0;
    margin: 1.25rem 0;
  }

  .docs-content blockquote p {
    color: #1e40af;
    margin: 0;
  }

  /* ── Footer ─────────────────────────────────────────── */
  .docs-footer {
    border-top: 1px solid var(--docs-border);
    padding: 1.25rem 2rem;
    text-align: center;
  }

  .docs-footer p {
    font-size: 0.8125rem;
    color: var(--docs-fg-faint);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .docs-layout {
      flex-direction: column;
    }

    .docs-sidebar {
      width: 100%;
      height: auto;
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--docs-border);
      padding: 0.75rem;
    }

    .docs-sidebar ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
    }

    .docs-content {
      padding: 2rem 1.5rem;
    }
  }
</style>
